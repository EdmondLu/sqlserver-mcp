{
  "server": "localhost,1433",
  "database": "SampleDb",
  "credentialTarget": "sqlserver-mcp/SampleDb",
  "limits": {
    "defaultLimit": 50,
    "maxRows": 500,
    "maxResultMb": 5,
    "maxTextLength": 1000,
    "maxLobMb": 50,
    "maxLobChunkSize": 262144,
    "lockTimeoutMs": 5000,
    "commandTimeoutSeconds": 20,
    "connectTimeoutSeconds": 10
  },
  "security": {
    "allowDmvQueries": true,
    "allowServerLevelDmv": false,
    "allowCrossDatabase": false,
    "allowSystemDatabases": false
  },
  "textSearch": {
    "snippetLength": 240,
    "targets": [
      {
        "profile": "default",
        "schema": "dbo",
        "table": "AppConfigScripts",
        "textColumn": "script_text",
        "keyColumn": "id",
        "nameColumn": "name",
        "labelColumns": ["page_name", "control_name"],
        "createdAtColumn": "created_at",
        "updatedAtColumn": "updated_at",
        "createdByColumn": "created_by",
        "updatedByColumn": "updated_by",
        "contentKind": "javascript",
        "enabled": false
      }
    ]
  },
  "compare": {
    "repoExcludePatterns": [
      "**/backup/**",
      "**/domain2/**"
    ]
  },
  "logging": {
    "logSql": false,
    "maxFileSizeMb": 10,
    "maxRetainedFiles": 7
  },
  "connection": {
    "encrypt": true,
    "trustServerCertificate": false,
    "applicationIntent": "ReadOnly"
  }
}
